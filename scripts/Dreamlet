##  DE tables and DEG summaries -----------------------------------------------

save_table(filter(de, fdr_sig), "DEGs_FDR10_main_model")
write.csv(de, gzfile(file.path(cfg$out_dir, "tables", "DE_all_main_model.csv.gz")),
          row.names = FALSE)

plot_deg_counts <- function(de, subtitle = NULL) {
  keys <- c("Down (FDR < 0.1)", "Down (nominal P < 0.05)",
            "Up (nominal P < 0.05)", "Up (FDR < 0.1)")
  d <- de %>%
    filter(nominal_sig | fdr_sig) %>%
    count(celltype, coef, direction, fdr_sig) %>%
    mutate(key = factor(case_when(
             direction == "DOWN" &  fdr_sig ~ keys[1],
             direction == "DOWN" & !fdr_sig ~ keys[2],
             direction == "UP"   & !fdr_sig ~ keys[3],
             TRUE                           ~ keys[4]), levels = keys),
           celltype = label_celltype(celltype),
           coef = factor(coef, levels = coef_order))
  ggplot(d, aes(celltype, n, fill = key)) +
    geom_col() +
    scale_fill_manual(values = setNames(c("dodgerblue4", "dodgerblue", "firebrick1", "firebrick3"), keys),
                      name = NULL) +
    scale_x_discrete(limits = rev) +
    coord_flip() +
    facet_wrap(~coef, ncol = 4) +
    labs(subtitle = subtitle, x = NULL, y = "Number of DEGs")
}
save_plot(plot_deg_counts(de, deparse(main$form)), "deg_counts_main", 14, 7)

##  Volcano and chromosomal logFC plots ---------------------------------------------

plot_volcano <- function(de, cf) {
  d <- de %>% filter(coef == cf) %>% mutate(celltype = label_celltype(celltype))
  ggplot(d, aes(logFC, -log10(P.Value))) +
    geom_point(data = filter(d, !is_cnv_gene), color = "grey70", size = 0.5) +
    geom_point(data = filter(d,  is_cnv_gene), color = "firebrick", size = 1.5) +
    geom_hline(yintercept = -log10(cfg$nominal_p), linetype = 2, color = "blue") +
    facet_wrap(~celltype, ncol = 3) +
    labs(title = cf, subtitle = "Red: genes within the CNV region")
}
for (cf in coefs)
  save_plot(plot_volcano(de, cf), paste0("volcano_", make.names(cf)), 10, 9)

coords_file <- file.path(cfg$data_dir, cfg$gene_coords_csv)
if (file.exists(coords_file)) {
  # NOTE: coordinates are GRCh37. Confirm they match the build used for
  # alignment/annotation, otherwise gene positions are wrong (see notes).
  gene_pos <- read.csv(coords_file) %>%
    setNames(c("ensembl_id", "gene", "chromosome", "gene_start", "gene_end", "strand")) %>%
    mutate(chromosome = as.character(chromosome)) %>%
    filter(chromosome %in% as.character(1:22)) %>%
    distinct(gene, .keep_all = TRUE)

  plot_chr_logfc <- function(de, cf, chr) {
    d <- de %>% filter(coef == cf) %>%
      inner_join(gene_pos, by = "gene") %>%
      filter(chromosome == chr) %>%
      mutate(celltype = label_celltype(celltype))
    ggplot(d, aes(gene_start / 1e6, logFC)) +
      geom_point(color = "grey40", size = 0.6) +
      geom_point(data = filter(d, is_cnv_gene), color = "firebrick", size = 1.2) +
      geom_smooth(method = "loess", formula = y ~ x, se = TRUE, linewidth = 0.6) +
      geom_hline(yintercept = 0) +
      facet_wrap(~celltype, ncol = 3) +
      labs(title = cf, subtitle = paste("logFC along chromosome", chr),
           x = "Position (Mb, GRCh37)", y = "logFC")
  }
  for (cf in coefs)
    save_plot(plot_chr_logfc(de, cf, cnv_chr[[cf]]),
              paste0("chr_logfc_", make.names(cf)), 10, 8)
}

##  Convergence between CNVs -----------------------------------------------------------

# Direction is defined from the sign of logFC (not from nominal significance),
# and genes are matched by name within cell type.
convergence_table <- function(de, coef_a, coef_b, fdr) {
  de %>%
    filter(coef %in% c(coef_a, coef_b)) %>%
    mutate(which = if_else(coef == coef_a, "a", "b")) %>%
    select(celltype, gene, which, logFC, adj.P.Val) %>%
    pivot_wider(names_from = which, values_from = c(logFC, adj.P.Val)) %>%
    group_by(celltype) %>%
    summarise(
      n_a = sum(adj.P.Val_a < fdr, na.rm = TRUE),
      n_b = sum(adj.P.Val_b < fdr, na.rm = TRUE),
      intersection = sum(adj.P.Val_a < fdr & adj.P.Val_b < fdr, na.rm = TRUE),
      union        = sum(adj.P.Val_a < fdr | adj.P.Val_b < fdr, na.rm = TRUE),
      same_direction = sum(adj.P.Val_a < fdr & adj.P.Val_b < fdr &
                             sign(logFC_a) == sign(logFC_b), na.rm = TRUE),
      .groups = "drop") %>%
    mutate(opposite_direction = intersection - same_direction,
           jaccard = if_else(union > 0, intersection / union, NA_real_),
           coef_a = coef_a, coef_b = coef_b, fdr = fdr)
}

conv <- bind_rows(lapply(cfg$convergence_fdr, function(f)
  bind_rows(combn(coefs, 2, simplify = FALSE) %>%
              map(~ convergence_table(de, .x[1], .x[2], f)))))
save_table(conv, "convergence_pairwise")

p_conv <- conv %>%
  filter(fdr == cfg$fdr_threshold, coef_a == "CNV22q11.2 del",
         coef_b %in% c("CNV16p11.2 del", "CNV7q11.23 WBS del")) %>%
  pivot_longer(c(same_direction, opposite_direction), names_to = "direction", values_to = "n") %>%
  mutate(celltype = label_celltype(celltype)) %>%
  ggplot(aes(n, celltype, fill = direction)) +
  geom_col() +
  scale_y_discrete(limits = rev) +
  facet_wrap(~coef_b) +
  labs(x = "Genes significant in both (FDR < 0.1)", y = NULL,
       title = "22q11.2 deletion vs other deletions")
save_plot(p_conv, "convergence_22q_vs_16p_7q", 10, 5)

# Correlation of t-statistics between CNVs, within cell type
t_corr <- de %>%
  select(celltype, gene, coef, t) %>%
  pivot_wider(names_from = coef, values_from = t) %>%
  group_split(celltype) %>%
  map(function(w) {
    m <- cor(select(w, -celltype, -gene), use = "pairwise.complete.obs")
    as.data.frame(as.table(m)) %>% setNames(c("cnv_x", "cnv_y", "r")) %>%
      mutate(celltype = w$celltype[1])
  }) %>% bind_rows()
save_table(t_corr, "t_statistic_correlation_between_cnvs")

p_tcorr <- t_corr %>%
  mutate(celltype = label_celltype(celltype),
         cnv_x = factor(cnv_x, levels = coef_order), cnv_y = factor(cnv_y, levels = coef_order)) %>%
  ggplot(aes(cnv_x, cnv_y, fill = r)) +
  geom_tile() +
  scale_fill_gradient2(low = "navy", mid = "white", high = "firebrick") +
  facet_wrap(~celltype, ncol = 3) +
  theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1)) +
  labs(x = NULL, y = NULL, fill = "r")
save_plot(p_tcorr, "t_statistic_correlation_heatmaps", 14, 12)

## Gene-set analysis (zenith) -----------------------------------------------------------

go_gs       <- get_GeneOntology(to = "SYMBOL")
hallmark_gs <- get_MSigDB("H", to = "SYMBOL")

run_zenith <- function(fit, gs, coefs = cnv_coefs(fit), use_ranks = FALSE) {
  bind_rows(lapply(coefs, function(cf)
    as.data.frame(zenith_gsa(fit, coef = cf, gs, use.ranks = use_ranks)) %>%
      mutate(coef = cf)))
}

zen_go <- cache_rds("zenith_go_main", run_zenith(main$fit, go_gs)) %>%
  mutate(t = delta / se)
zen_h  <- cache_rds("zenith_hallmark_main", run_zenith(main$fit, hallmark_gs)) %>%
  mutate(t = delta / se)
save_table(filter(zen_go, FDR < cfg$fdr_threshold), "zenith_GO_FDR10")
save_table(filter(zen_h,  FDR < cfg$fdr_threshold), "zenith_Hallmark_FDR10")

plot_zenith_sig <- function(zen, tag) {
  for (cf in unique(zen$coef)) {
    sig <- unique(zen$Geneset[zen$coef == cf & zen$FDR < cfg$fdr_threshold])
    d   <- zen %>% filter(coef == cf, Geneset %in% sig)
    if (nrow(d) == 0) next
    d$assay <- label_celltype(d$assay)
    save_plot(plotZenithResults(d, 5, 1) +
                scale_y_discrete(labels = function(y) str_wrap(y, width = 30)) +
                ggtitle(paste(tag, cf)),
              paste0("zenith_", tag, "_", make.names(cf)), 8, 10)
  }
}
plot_zenith_sig(zen_go, "GO")
plot_zenith_sig(zen_h,  "Hallmark")

## 7a. Mitochondrial / OXPHOS-focused summary
mito_terms <- c(
  "GO0006119: oxidative phosphorylation",
  "GO0005746: mitochondrial respirasome",
  "GO0036293: response to decreased oxygen levels",
  "GO0006757: ATP generation from ADP",
  "GO0034599: cellular response to oxidative stress",
  "GO0042775: mitochondrial ATP synthesis coupled electron transport",
  "GO0061620: glycolytic process through glucose-6-phosphate")
stopifnot(all(mito_terms %in% unique(zen_go$Geneset)))

p_mito <- zen_go %>%
  filter(Geneset %in% mito_terms) %>%
  mutate(assay = label_celltype(assay), coef = factor(coef, levels = rev(coef_order)),
         star = if_else(FDR < cfg$fdr_threshold, "*", "")) %>%
  ggplot(aes(assay, coef, fill = t, label = star)) +
  geom_tile() + geom_text(vjust = 0.8) +
  scale_fill_gradient2(low = "blue", mid = "white", high = "red", name = "t-statistic") +
  facet_wrap(~Geneset, labeller = labeller(Geneset = label_wrap_gen(40)), ncol = 2) +
  theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  labs(x = NULL, y = NULL, caption = "* FDR < 0.1")
save_plot(p_mito, "zenith_mitochondrial_terms", 12, 12)

## 7b. Gene-level heatmaps for selected GO terms
plot_gene_heatmap <- function(de, genes, title, fdr = cfg$fdr_threshold) {
  d <- de %>%
    filter(gene %in% genes) %>%
    mutate(celltype = label_celltype(celltype),
           coef = factor(coef, levels = coef_order),
           star = if_else(adj.P.Val < fdr, "*", ""))
  zmax <- max(abs(d$z.std), na.rm = TRUE)
  ggplot(d, aes(celltype, gene, fill = z.std, label = star)) +
    geom_tile() + geom_text(vjust = 0.8, size = 3) +
    scale_fill_gradient2("z", low = "blue", mid = "white", high = "red",
                         limits = c(-zmax, zmax), na.value = "grey70") +
    facet_wrap(~coef, nrow = 1) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
    labs(title = title, x = NULL, y = NULL, caption = paste("* FDR <", fdr))
}

heatmap_terms <- c(
  "GO0006119: oxidative phosphorylation",
  "GO0005746: mitochondrial respirasome",
  "GO0005747: mitochondrial respiratory chain complex I",
  "GO0005749: mitochondrial respiratory chain complex II, succinate dehydrogenase complex (ubiquinone)",
  "GO0005750: mitochondrial respiratory chain complex III")
for (term in intersect(heatmap_terms, names(go_gs))) {
  genes <- sort(geneIds(go_gs[[term]]))
  save_plot(plot_gene_heatmap(de, genes, term),
            paste0("geneheatmap_", make.names(substr(term, 1, 40))),
            width = 20, height = max(4, 0.15 * length(genes) + 2))
}

## mashr ---------------------------------------------------------------------------------

mash_res <- cache_rds("mash_main", setNames(lapply(coefs, function(cf)
  run_mash(main$fit, coef = cf)), coefs))

mash_summary <- bind_rows(lapply(names(mash_res), function(cf) {
  lfsr <- get_lfsr(mash_res[[cf]]$model)
  bind_rows(
    tibble(coef = cf, celltype = "ANY", n_sig = sum(apply(lfsr, 1, min, na.rm = TRUE) < 0.05)),
    tibble(coef = cf, celltype = colnames(lfsr), n_sig = colSums(lfsr < 0.05, na.rm = TRUE)))
}))
save_table(mash_summary, "mashr_lfsr_lt_0.05_counts")

mash_go <- cache_rds("mash_zenith_go", lapply(mash_res, zenith_gsa, gs = go_gs))

##  Sensitivity models ----------------------------------------------------------------------

sens <- bind_rows(imap(models, ~ .x$de %>%
  filter(fdr_sig) %>% count(celltype, coef, name = "n_fdr_sig") %>% mutate(model = .y)))
save_table(sens, "sensitivity_deg_counts_by_model")

p_sens <- sens %>%
  mutate(celltype = label_celltype(celltype), coef = factor(coef, levels = coef_order)) %>%
  ggplot(aes(celltype, n_fdr_sig, fill = model)) +
  geom_col(position = "dodge") +
  scale_x_discrete(limits = rev) + coord_flip() +
  facet_wrap(~coef, ncol = 3) +
  labs(x = NULL, y = "DEGs at FDR < 0.1")
save_plot(p_sens, "sensitivity_deg_counts", 14, 9)

# Concordance of t-statistics between main and each sensitivity model
sens_cor <- bind_rows(imap(models[setdiff(names(models), "main")], function(m, nm)
  inner_join(select(de, celltype, gene, coef, t_main = t),
             select(m$de, celltype, gene, coef, t_alt = t),
             by = c("celltype", "gene", "coef")) %>%
    group_by(celltype, coef) %>%
    summarise(r = cor(t_main, t_alt, use = "complete.obs"), .groups = "drop") %>%
    mutate(model = nm)))
save_table(sens_cor, "sensitivity_t_correlation_with_main")

