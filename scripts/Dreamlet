# =============================================================================
# Cell-type-specific differential expression in adult snRNA-seq from carriers of
# recurrent CNVs (dreamlet pseudobulk analysis)
# Author of original analysis: Gabi Dugan
# =============================================================================

suppressPackageStartupMessages({
  library(SingleCellExperiment)
  library(Seurat)
  library(dreamlet)
  library(variancePartition)
  library(zenith)
  library(GSEABase)
  library(BiocParallel)
  library(lmerTest)       # lmer with p-values
  library(dplyr)
  library(tidyr)
  library(tibble)
  library(purrr)
  library(stringr)
  library(ggplot2)
  library(cowplot)
})

set.seed(1)

cfg <- list(
  data_dir        = "data",
  out_dir         = "results",
  metadata_csv    = "sample_metadata.csv",
  seurat_rds      = "seurat_adult_annotated.rds",
  cnv_genes_rds   = "genes_in_cnv_regions.rds",
  gene_coords_csv = "biomart_genes_GRCh37.csv",
  exclude_samples = "Sample_30_HBCC_2550_ACC",   # state the exclusion reason in Methods
  # Genes removed before DE: cytosolic ribosomal protein genes and mitochondrial-
  # encoded genes. Anchored so nuclear-encoded mitochondrial ribosomal genes
  # (MRPL*, MRPS*) are RETAINED. The original script used unanchored "RPL|RPS|MT-"
  # which also removed MRPL*/MRPS*; see CHANGES_AND_ISSUES.md.
  gene_exclude_regex = "^(RPL|RPS)[0-9]|^RPLP[0-2]$|^MT-",
  min_cells       = 0,       # dreamlet processAssays(min.cells); dreamlet default is 5
  fdr_threshold   = 0.1,
  nominal_p       = 0.05,
  convergence_fdr = c(0.1, 0.5),
  n_workers       = 6,
  run_sensitivity = TRUE,    # extra covariate models (section 2)
  recompute       = FALSE
)

for (d in c("rds", "figures", "tables"))
  dir.create(file.path(cfg$out_dir, d), recursive = TRUE, showWarnings = FALSE)

bp <- SnowParam(cfg$n_workers, progressbar = TRUE)
theme_set(theme_cowplot(font_size = 11))

##  Constants -----------------------------------------------------------

# Internal cell-type names -> display labels
celltype_labels <- c(
  Inhibitory_CGE  = "CGE-derived inhibitory neurons",
  Inhibitory_MGE  = "MGE-derived inhibitory neurons",
  L2_3Excitatory  = "Upper-layer excitatory neurons",
  L5_6Excitatory  = "Lower-layer excitatory neurons",
  Astrocyte       = "Astrocyte",
  Microglia       = "Microglia",
  Oligodendrocytes = "Oligodendrocyte",
  OPC             = "OPC",
  VLMC_Endo       = "VLMC/endothelial"
)

# Levels of the CNV factor in the metadata; first = reference
cnv_levels <- c("non-carrier", "22q11.2 del", "22q11.2 dup", "16p11.2 del",
                "16p11.2 dup", "7q11.23 WBS del", "15q11.2 BP1-2 del",
                "15q11.2 BP1-2 dup", "1q21.1 del", "1q21.1 dup")

# Display order for facets (dreamlet coefficient names are "CNV" + level)
coef_order <- paste0("CNV", c("22q11.2 del", "22q11.2 dup", "16p11.2 del",
                              "16p11.2 dup", "7q11.23 WBS del", "1q21.1 del",
                              "1q21.1 dup", "15q11.2 BP1-2 del", "15q11.2 BP1-2 dup"))

# Which element of Genes_inCNVregions holds the genes inside each CNV region
cnv_gene_sets <- c(
  "CNV15q11.2 BP1-2 del" = "HBCC_6_15q11del",
  "CNV15q11.2 BP1-2 dup" = "HBCC_6_15q11del",
  "CNV16p11.2 del"       = "HBCC_2_16p11del",
  "CNV16p11.2 dup"       = "HBCC_8_16p11dup",
  "CNV1q21.1 del"        = "HBCC_1_1q21del",
  "CNV1q21.1 dup"        = "HBCC_2_1q21dup",
  "CNV22q11.2 del"       = "SMRI_2_22q11del",
  "CNV22q11.2 dup"       = "SMRI_3_22q11dup",
  "CNV7q11.23 WBS del"   = "UMB_2_7q11del"
)

cnv_chr <- c(
  "CNV15q11.2 BP1-2 del" = "15", "CNV15q11.2 BP1-2 dup" = "15",
  "CNV16p11.2 del" = "16", "CNV16p11.2 dup" = "16",
  "CNV1q21.1 del" = "1",   "CNV1q21.1 dup" = "1",
  "CNV22q11.2 del" = "22", "CNV22q11.2 dup" = "22",
  "CNV7q11.23 WBS del" = "7"
)

# Shared covariates added to the pseudobulk colData
sample_covariates <- c("HBCC_BrNum", "Match_group", "Region", "CNV", "Sex", "Age",
                       "PMI", "pH", "bulk_RIN", "Sequencing.Saturation",
                       "Estimated.Number.of.Cells", "nFeature_RNA")

## Helpers -------------------------------------------------------------

cache_rds <- function(name, expr) {
  f <- file.path(cfg$out_dir, "rds", paste0(name, ".rds"))
  if (file.exists(f) && !cfg$recompute) return(readRDS(f))
  res <- force(expr)
  saveRDS(res, f)
  res
}

save_plot <- function(p, name, width = 7, height = 5) {
  base <- file.path(cfg$out_dir, "figures", name)
  ggsave(paste0(base, ".pdf"), p, width = width, height = height)
  ggsave(paste0(base, ".png"), p, width = width, height = height, dpi = 300)
  invisible(p)
}

save_table <- function(x, name) {
  write.csv(x, file.path(cfg$out_dir, "tables", paste0(name, ".csv")), row.names = FALSE)
}

label_celltype <- function(x) {
  x   <- as.character(x)
  lab <- unname(celltype_labels[x])
  lab[is.na(lab)] <- x[is.na(lab)]          # e.g. cell-class names
  factor(lab, levels = unique(c(unname(celltype_labels), lab)))
}

cnv_coefs <- function(fit) grep("^CNV", coefNames(fit), value = TRUE)

## Data ------------------------------------------------------------------

sample_meta <- read.csv(file.path(cfg$data_dir, cfg$metadata_csv)) %>%
  filter(!orig.ident %in% cfg$exclude_samples)
stopifnot(!anyDuplicated(sample_meta$orig.ident),
          all(sample_meta$CNV %in% cnv_levels))

pseudobulk <- cache_rds("pseudobulk", {
  seu <- readRDS(file.path(cfg$data_dir, cfg$seurat_rds))
  seu <- subset(seu, cells = colnames(seu)[seu$orig.ident %in% sample_meta$orig.ident])
  sce <- as.SingleCellExperiment(seu)
  rm(seu); invisible(gc())
  list(
    subclass = aggregateToPseudoBulk(sce, assay = "counts",
                                     cluster_id = "subclass.annotation",
                                     sample_id = "orig.ident", BPPARAM = bp),
    class    = aggregateToPseudoBulk(sce, assay = "counts",
                                     cluster_id = "cell.class.annotation",
                                     sample_id = "orig.ident", BPPARAM = bp),
    composition = as.data.frame(colData(sce)) %>%
      count(orig.ident, celltype = subclass.annotation, name = "n_celltype") %>%
      group_by(orig.ident) %>%
      mutate(n_sample = sum(n_celltype), prop = n_celltype / n_sample) %>%
      ungroup()
  )
})
composition <- pseudobulk$composition

sample_meta <- sample_meta %>%
  left_join(distinct(composition, orig.ident, n_cells_sample = n_sample), by = "orig.ident")

prepare_pb <- function(pb) {
  # sample-level covariates (only those not already present)
  need <- setdiff(c(sample_covariates, "n_cells_sample"), colnames(colData(pb)))
  idx  <- match(colnames(pb), sample_meta$orig.ident)
  stopifnot(!anyNA(idx))
  for (v in need) colData(pb)[[v]] <- sample_meta[[v]][idx]

  pb$CNV        <- factor(as.character(pb$CNV), levels = cnv_levels)
  pb$HBCC_BrNum <- as.character(pb$HBCC_BrNum)   # grouping factor, not numeric

  drop <- grepl(cfg$gene_exclude_regex, rownames(pb))
  message(sum(drop), " genes removed by gene_exclude_regex; ", sum(!drop), " retained")
  pb[!drop, ]
}

pb_main  <- prepare_pb(pseudobulk$subclass)
pb_class <- prepare_pb(pseudobulk$class)

# Cell-type-specific covariate: proportion of the sample's nuclei in each cell type
am <- metadata(pb_main)$aggr_means
am$celltype.prop <- composition$prop[match(
  paste(am$orig.ident, am$subclass.annotation),
  paste(composition$orig.ident, composition$celltype))]
stopifnot(!anyNA(am$celltype.prop))
metadata(pb_main)$aggr_means <- am

# Genes located inside each CNV region -> named list keyed by coefficient name
genes_in_cnv <- readRDS(file.path(cfg$data_dir, cfg$cnv_genes_rds))
cnv_region_genes <- map(cnv_gene_sets, ~ genes_in_cnv[[.x]]$Gene.name)

##  dreamlet models ---------------------------------------------------------

get_de_table <- function(fit, coefs = cnv_coefs(fit)) {
  grid <- expand.grid(celltype = names(fit), coef = coefs, stringsAsFactors = FALSE)
  bind_rows(lapply(seq_len(nrow(grid)), function(i) {
    tt <- topTable(fit[[grid$celltype[i]]], coef = grid$coef[i],
                   number = Inf, confint = TRUE)
    tt$gene <- rownames(tt); rownames(tt) <- NULL
    tt$celltype <- grid$celltype[i]; tt$coef <- grid$coef[i]
    tt
  }))
}

annotate_de <- function(de, region_genes = cnv_region_genes) {
  cnv_keys <- unlist(imap(region_genes, ~ paste(.y, .x)))
  de %>% mutate(
    direction   = if_else(logFC > 0, "UP", "DOWN"),
    nominal_sig = P.Value < cfg$nominal_p,
    fdr_sig     = adj.P.Val < cfg$fdr_threshold,   # FDR within cell type x coefficient
    z.std       = sign(t) * qnorm(P.Value / 2, lower.tail = FALSE),
    is_cnv_gene = paste(coef, gene) %in% cnv_keys
  )
}

run_dreamlet <- function(pb, form, tag) {
  proc <- cache_rds(paste0("proc_", tag),
                    processAssays(pb, form, min.cells = cfg$min_cells, BPPARAM = bp))
  fit  <- cache_rds(paste0("fit_", tag), dreamlet(proc, form, BPPARAM = bp))
  de   <- cache_rds(paste0("de_", tag), annotate_de(get_de_table(fit)))
  list(form = form, proc = proc, fit = fit, de = de)
}

random_effects <- ~ (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group)
forms <- list(
  main               = ~ CNV + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group),
  plus_ncells        = ~ CNV + n_cells_sample + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group),
  plus_nfeature      = ~ CNV + nFeature_RNA + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group),
  plus_rin_nfeature  = ~ CNV + bulk_RIN + nFeature_RNA + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group),
  plus_celltype_prop = ~ CNV + celltype.prop + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group)
)
if (!cfg$run_sensitivity) forms <- forms["main"]

models <- imap(forms, ~ run_dreamlet(pb_main, .x, .y))
main   <- models$main
de     <- main$de
coefs  <- cnv_coefs(main$fit)
stopifnot(setequal(coefs, coef_order))

##  QC -------------------------------------------------------------------

## 3a. Sample composition (PCA of cell-type counts and proportions)
comp_matrix <- function(value) {
  composition %>%
    select(orig.ident, celltype, all_of(value)) %>%
    pivot_wider(names_from = celltype, values_from = all_of(value), values_fill = 0) %>%
    column_to_rownames("orig.ident")
}

plot_composition_pca <- function(mat, color, title) {
  pc <- prcomp(mat, scale. = TRUE)
  ve <- 100 * pc$sdev^2 / sum(pc$sdev^2)
  as.data.frame(pc$x[, 1:2]) %>%
    rownames_to_column("orig.ident") %>%
    left_join(sample_meta, by = "orig.ident") %>%
    ggplot(aes(PC1, PC2, color = .data[[color]])) +
    geom_point(size = 2) +
    labs(title = title, x = sprintf("PC1 (%.1f%%)", ve[1]), y = sprintf("PC2 (%.1f%%)", ve[2]))
}

p_comp <- plot_grid(
  plot_composition_pca(log1p(comp_matrix("n_celltype")), "CNV",    "Cell-type counts (log1p)"),
  plot_composition_pca(comp_matrix("prop"),              "CNV",    "Cell-type proportions"),
  plot_composition_pca(comp_matrix("prop"),              "Region", "Cell-type proportions"),
  plot_composition_pca(comp_matrix("prop"),              "Match_group", "Cell-type proportions"),
  ncol = 2)
save_plot(p_comp, "qc_composition_pca", 12, 9)

## 3b. Library size per sample and cell type
libsize <- bind_rows(lapply(names(main$proc), function(ct)
  tibble(orig.ident = rownames(main$proc[[ct]]$targets),
         lib.size = main$proc[[ct]]$targets$lib.size, celltype = ct))) %>%
  left_join(select(sample_meta, orig.ident, CNV), by = "orig.ident") %>%
  mutate(celltype = label_celltype(celltype),
         CNV = relevel(factor(CNV), ref = "non-carrier")) %>%
  group_by(celltype) %>% mutate(median_lib = median(lib.size)) %>% ungroup()

p_lib <- ggplot(libsize, aes(orig.ident, lib.size, fill = CNV)) +
  geom_col() +
  geom_hline(aes(yintercept = median_lib), linetype = 2) +
  scale_fill_viridis_d() +
  coord_flip() + facet_wrap(~celltype, ncol = 3) +
  labs(x = NULL, y = "Library size (pseudobulk counts)")
save_plot(p_lib, "qc_library_size", 11, 17)

## 3c. Association of top PCs with technical/biological covariates, after
##     removing the modelled terms (CNV + random effects)
pc_covariate_assoc <- function(E, md, covars, n_pc = 10) {
  md  <- md[colnames(E), , drop = FALSE]
  pcs <- prcomp(t(E))$x
  n_pc <- min(n_pc, ncol(pcs))
  bind_rows(lapply(seq_len(n_pc), function(k) {
    d   <- data.frame(pc = pcs[, k], md)
    fit <- tryCatch(lmerTest::lmer(pc ~ CNV + (1 | HBCC_BrNum) + (1 | Region) + (1 | Match_group),
                                   data = d), error = function(e) NULL)
    r <- if (is.null(fit)) rep(NA_real_, nrow(d)) else resid(fit)
    bind_rows(lapply(covars, function(v) {
      p <- tryCatch(anova(lm(r ~ d[[v]]))$`Pr(>F)`[1], error = function(e) NA_real_)
      tibble(PC = factor(paste0("PC", k), levels = paste0("PC", seq_len(n_pc))),
             covariate = v, p = p)
    }))
  }))
}

md_all <- as.data.frame(colData(pb_main)); rownames(md_all) <- colnames(pb_main)
qc_covars <- c("Sex", "Age", "PMI", "pH", "bulk_RIN", "Sequencing.Saturation",
               "Estimated.Number.of.Cells", "nFeature_RNA")

pc_assoc <- bind_rows(lapply(names(main$proc), function(ct)
  mutate(pc_covariate_assoc(main$proc[[ct]]$E, md_all, qc_covars), celltype = ct))) %>%
  mutate(celltype = label_celltype(celltype))
save_table(pc_assoc, "qc_pc_covariate_associations")

p_pc <- ggplot(pc_assoc, aes(PC, covariate, fill = -log10(p))) +
  geom_tile(color = "white") +
  scale_fill_gradient(low = "white", high = "steelblue4", name = "-log10(P)") +
  facet_wrap(~celltype, ncol = 3) +
  theme(axis.text.x = element_text(angle = 90, vjust = 0.5)) +
  labs(x = NULL, y = NULL)
save_plot(p_pc, "qc_pc_covariate_heatmap", 14, 10)

## 3d. Variance partitioning
vp_form <- ~ (1 | CNV) + (1 | Region) + (1 | HBCC_BrNum) + (1 | Match_group) +
  PMI + bulk_RIN + Estimated.Number.of.Cells + nFeature_RNA
vp <- cache_rds("varpart_main", fitVarPart(main$proc, vp_form, BPPARAM = bp))
p_vp <- plotVarPart(vp, label.angle = 60) +
