##  7q11.23 deletion: matched groups analysed separately ---------------------------------------------

form_7q  <- ~ CNV + (1 | Region) + (1 | HBCC_BrNum)
groups_7q <- c("UMB_2", "UMB_3")
res_7q <- setNames(lapply(groups_7q, function(g) {
  pb <- pb_main[, pb_main$Match_group == g]
  pb$CNV <- droplevels(pb$CNV)
  run_dreamlet(pb, form_7q, paste0("7q11_", g))
}), groups_7q)

# Reproducibility of the 7q11.23 effect between the two matched groups
cf7 <- "CNV7q11.23 WBS del"
rep_7q <- inner_join(
  res_7q$UMB_2$de %>% filter(coef == cf7) %>% select(celltype, gene, t_UMB_2 = t),
  res_7q$UMB_3$de %>% filter(coef == cf7) %>% select(celltype, gene, t_UMB_3 = t),
  by = c("celltype", "gene")) %>%
  group_by(celltype) %>%
  summarise(r = cor(t_UMB_2, t_UMB_3, use = "complete.obs"), n_genes = n(), .groups = "drop")
save_table(rep_7q, "7q11_matchgroup_t_correlation")

zen_7q <- bind_rows(lapply(groups_7q, function(g)
  cache_rds(paste0("zenith_go_7q11_", g), run_zenith(res_7q[[g]]$fit, go_gs, coefs = cf7)) %>%
    mutate(match_group = g)))
save_table(filter(zen_7q, FDR < cfg$fdr_threshold), "zenith_GO_7q11_by_matchgroup_FDR10")
